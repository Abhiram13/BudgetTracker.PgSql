{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Error",
                "System": "Error",
                "BudgetTracker.Infrastructure.Security": "Information",
                "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Error"
            }
        },
        "Filter": [
            {
                "Name": "ByExcluding"
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
    }
}