<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNameSpace>BudgetTracker.Gateway</RootNameSpace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
        <PackageReference Include="Yarp.ReverseProxy" />
        <PackageReference Include="Abhiram.Extensions.DotEnv" />
        <PackageReference Include="Abhiram.Abstractions.Logging" />
        <PackageReference Include="Abhiram.Secrets.Providers" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BudgetTracker.Shared\BudgetTracker.Shared.csproj" />
        <ProjectReference Include="..\BudgetTracker.Warehouse\BudgetTracker.Warehouse.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Services\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\sharedsettings.json">
            <Link>sharedsettings.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
        <None Include="..\sharedsettings.Development.json">
            <Link>sharedsettings.Development.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
        <None Include="..\sharedsettings.GoogleCloud.json">
            <Link>sharedsettings.GoogleCloud.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
    </ItemGroup>

</Project>
