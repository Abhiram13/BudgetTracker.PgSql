{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Warning",
            "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "finance-transactions-route": {
                "ClusterId": "finance-cluster",
                "Match": {
                    "Path": "/api/transactions/{**catch-all}"
                }
            },
            "finance-categories-route": {
                "ClusterId": "finance-cluster",
                "Match": {
                    "Path": "/api/categories/{**any}"
                },
                "Transforms": [
                    { "RequestHeaderOriginalHost": "false" }
                ]
            },
            "finance-banks-route": {
                "ClusterId": "finance-cluster",
                "Match": {
                    "Path": "/api/banks/{**catch-all}"
                }
            },
            "finance-dues-route": {
                "ClusterId": "finance-cluster",
                "Match": {
                    "Path": "/api/dues/{**catch-all}"
                }
            },
            "warehouse-route": {
                "ClusterId": "warehouse-cluster",
                "Match": {
                    "Path": "/api/query/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "finance-cluster": {
                "Destinations": {
                    "instance-01": {
                        "Address": "http://localhost:3001/"
                    }
                }
            },
            "warehouse-cluster": {
                "Destinations": {
                    "instance-01": {
                        "Address": "http://localhost:3004/"
                    }
                }
            }
        }
    },
    "Serilog": {
        "Properties": {
            "Application": "BudgetTracker.Gateway"
        }
    }
}