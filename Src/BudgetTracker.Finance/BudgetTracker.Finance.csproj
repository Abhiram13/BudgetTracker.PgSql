<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNameSpace>BudgetTracker.Finance</RootNameSpace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Abhiram.Secrets.Providers" />
        <PackageReference Include="Abhiram.Extensions.DotEnv" />
        <PackageReference Include="Abhiram.Abstractions.Logging" />
        <PackageReference Include="EntityFramework6.Npgsql" />
        <PackageReference Include="Google.Cloud.PubSub.V1" />      
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />      
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />      
        <PackageReference Include="Microsoft.EntityFrameworkCore" />      
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>      
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BudgetTracker.Shared\BudgetTracker.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\sharedsettings.json">
            <Link>sharedsettings.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
        <None Include="..\sharedsettings.Development.json" Condition="Exists('..\sharedsettings.Development.json')">
            <Link>sharedsettings.Development.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
        <None Include="..\sharedsettings.GoogleCloud.json" Condition="Exists('..\sharedsettings.GoogleCloud.json')">
            <Link>sharedsettings.GoogleCloud.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
        <None Include="..\sharedsettings.Test.json" Condition="Exists('..\sharedsettings.Test.json')">
            <Link>sharedsettings.Test.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>Program.cs</DependentUpon>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\.dockerignore">
          <Link>.dockerignore</Link>
        </Content>
        <Content Include=".googlecloud\cloudbuild.yaml" />
    </ItemGroup>

    <PropertyGroup>
        <ReferenceCopyLocalPathsOutputGroupIncludeMetadata>
            $(ReferenceCopyLocalPathsOutputGroupIncludeMetadata);SerializedXmlDocumentation
        </ReferenceCopyLocalPathsOutputGroupIncludeMetadata>
    </PropertyGroup>

</Project>