{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Update": "Critical",
            "Microsoft.EntityFrameworkCore.Database.Command": "Critical"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
                "Microsoft.EntityFrameworkCore.Update": "Critical"
            }
        }
    },
    "AllowedHosts": "*"
}