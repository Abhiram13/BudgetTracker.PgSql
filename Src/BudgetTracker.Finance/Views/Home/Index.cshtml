@{
    ViewData["Title"] = "Home Page";
}

@using BudgetTracker.Finance.Models
@using BudgetTracker.Finance.Mvc.Models
@model TransactionModel

@* https://getbootstrap.com/docs/5.3/content/tables/ *@
<section>
    <section class="container text-center">
        <div class="row">
            <a type="button" class="btn btn-primary col" asp-controller="TransactionView" asp-action="PreviousMonth" asp-route-month="@Model.SelectedMonth" asp-route-year="@Model.SelectedYear">Previous</a>
            <p class="col">June</p>
            <button type="button" class="btn btn-primary col">Next</button>
        </div>
    </section>

    <section>
        <div>
            <p>Total Transactions: @Model.Count</p>
        </div>

        <table class="table">
            <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Debit</th>
                <th scope="col">Credit</th>
            </tr>
            </thead>
            <tbody>
            @foreach (TransactionsListByMonthYear transaction in Model.Transactions)
            {
                <tr>
                    <td>@transaction.TransactionDate</td>
                    <td>@transaction.Debit</td>
                    <td>@transaction.Credit</td>
                </tr>
            }
            </tbody>
        </table>
    </section>

</section>